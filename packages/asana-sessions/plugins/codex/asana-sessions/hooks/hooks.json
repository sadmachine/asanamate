{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "asana-sessions hook codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${XDG_STATE_HOME:-}; case $d in /*) ;; *) d=$HOME/.local/state ;; esac; set -- \"$d\"/asana-sessions/pending/codex-*.json; test -e \"$1\" || { cat >/dev/null; exit 0; }; asana-sessions hook codex",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "asana-sessions hook codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
